{
  "name": "paid-service-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/sanitize-standalone.mjs",
    "build:profile": "next build --webpack --experimental-cpu-prof && node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:component && npm run test:contract && npm run test:integration && npm run test:reliability",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration:prepare": "tsx scripts/prepare-test-database.ts",
    "test:integration": "npm run test:integration:prepare && vitest run --config vitest.integration.config.ts",
    "test:skill-vertical": "npm run test:integration:prepare && vitest run --config vitest.integration.config.ts src/lib/__tests__/skill-information-vertical.integration.test.ts src/lib/__tests__/skill-information-action-drift.integration.test.ts",
    "test:e2e:prepare": "npm run test:integration:prepare && tsx --env-file=.env.test scripts/prepare-e2e-fixture.ts",
    "test:e2e": "npm run test:e2e:prepare && playwright test && playwright test --config playwright.services.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:reliability": "node --test scripts/retired-operator-scripts.test.mjs scripts/container-source.test.mjs scripts/sanitize-standalone.test.mjs scripts/admin-cost-budgets.test.mjs scripts/probe-production-health.test.mjs scripts/runtime-next-config.test.mjs scripts/next-image-boundary.test.mjs && npm --prefix deploy/cloudflare/maintenance-worker test",
    "test:watch": "vitest --config vitest.config.ts",
    "check:ui-foundation": "node scripts/check-ui-foundation.mjs",
    "check:api-route-boundaries": "tsx scripts/check-api-route-boundaries.ts",
    "check:agent-skill": "node scripts/check-agent-skill.mjs",
    "check:plugin-package": "tsx scripts/package-cabai-plugin.ts cabai",
    "plugin:package": "tsx scripts/package-cabai-plugin.ts",
    "openapi:generate": "tsx scripts/generate-agent-openapi.ts",
    "openapi:check": "tsx scripts/check-agent-openapi.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "wp10:probe": "tsx scripts/wp10-skill-artifact-probe.ts",
    "admin:cost:check": "tsx --env-file-if-exists=.env.test scripts/admin-cost-baseline.ts",
    "container:health": "node scripts/container-health.mjs",
    "test:production-migrations": "node scripts/verify-production-migrations.mjs",
    "check:ci-policy": "node scripts/check-ci-policy.mjs && node --test scripts/check-ci-policy.test.mjs",
    "check:ci-scope": "node --test scripts/classify-ci-scope.test.mjs",
    "check:migrations": "tsx scripts/check-migration-snapshots.ts",
    "audit:migrations:applied": "tsx --env-file-if-exists=.env scripts/audit-applied-migrations.ts",
    "verify": "npm run verify:full",
    "check:docs": "node tools/docs.mjs check",
    "verify:static": "npm run check:docs && npm run lint && npm run check:ci-policy && npm run check:ci-scope && npm run check:migrations && npm run check:ui-foundation && npm run check:api-route-boundaries && npm run openapi:check && npm run check:agent-skill && npm run check:plugin-package && npm run typecheck",
    "verify:fast": "npm run verify:static && npm run test:unit && npm run test:component && npm run test:reliability",
    "verify:full": "npm run verify:fast && npm run test:contract && npm run test:integration && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node scripts/run-migrations.mjs",
    "start:production": "node scripts/start-production.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "script:bootstrap-admin": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "script:test-callback": "node --env-file=.env scripts/test-callback.mjs",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:backup:list": "tsx --env-file-if-exists=.env scripts/db-backup.ts --list",
    "db:backup:verify": "tsx --env-file-if-exists=.env scripts/db-backup.ts --verify",
    "db:backup:audit-lifecycle": "tsx --env-file-if-exists=.env scripts/audit-backup-lifecycle.ts",
    "db:restore:drill": "tsx --env-file-if-exists=.env scripts/db-restore-drill.ts",
    "script:seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "test:recovery": "node --import tsx --test scripts/local-recovery.test.mts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@auth/drizzle-adapter": "1.11.3",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "5.4.0",
    "@phosphor-icons/react": "^2.1.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "1.2.12",
    "@sentry/nextjs": "10.65.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.0.0",
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "^4.2.1",
    "novel": "^1.0.2",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "7.81.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.1",
    "winston": "^3.19.0",
    "yaml": "2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.1",
    "shell-quote": "1.11.0",
    "ws": "8.21.0"
  },
  "license": "Apache-2.0"
}
