# ─── Database ───
DATABASE_URL=postgresql://paid_service:paid_service_local_only@127.0.0.1:5432/paid_service

# ─── Auth.js ───
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Single-instance deployments use auto. Compose/multi-replica app processes use external.
MIGRATION_MODE=auto
# Public site identity. Forks should replace every value before publishing.
NEXT_PUBLIC_SITE_NAME=CabAI
NEXT_PUBLIC_SITE_INITIAL=AI
# Public build-time settings; rebuild after changes. Same-origin static image paths.
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_LOGO=/oss/icon.svg
NEXT_PUBLIC_SITE_SOCIAL_IMAGE=/oss/social.png
NEXT_PUBLIC_SITE_ILLUSTRATION=/oss/learning.svg
NEXT_PUBLIC_CREATOR_NAME=Site Creator
NEXT_PUBLIC_CREATOR_URL=https://example.com
SITE_LEGAL_NAME=CabAI
CONTACT_EMAIL=support@example.com
SITE_DEFAULT_LOCALE=zh-TW
# Public Kit embed identifiers for the /subscribe general-updates page. These
# are not management credentials and are safe to expose in rendered form markup.
KIT_GENERAL_UPDATES_FORM_ID=
KIT_GENERAL_UPDATES_FORM_UID=
# Optional HTTPS asset/CDN origin used by Next Image and CSP. Existing R2
# deployments may rely on CLOUDFLARE_R2_PUBLIC_URL instead.
# NEXT_PUBLIC_ASSET_HOST=https://assets.your-domain.com
# Container builds bake NEXT_PUBLIC_* values into the image. Rebuild after
# changing the public site name, app URL, or asset host.

# ─── Portaly Payment ───
# Mode: "test" or "live"
PORTALY_MODE=test
# Set true only in a production deployment that must reject every sandbox checkout.
PORTALY_REQUIRE_LIVE=false

# Unified credentials preferred by the current Portaly Payment Skill.
# A key's mode is derived from its prefix: pcs_test_xxx or pcs_live_xxx.
PORTALY_API_KEY=
PORTALY_CALLBACK_SECRET=
PORTALY_API_HOST=https://portaly.ai

# Legacy mode-specific credentials are still supported by this project.
# Do not uncomment these while PORTALY_API_KEY / PORTALY_CALLBACK_SECRET are set.
# Live credentials
# PORTALY_LIVE_API_KEY=pcs_live_xxx
# PORTALY_LIVE_CALLBACK_SECRET=pcs_cb_xxx

# Test (sandbox) credentials
# PORTALY_TEST_API_KEY=pcs_test_xxx
# PORTALY_TEST_CALLBACK_SECRET=pcs_cb_xxx

# PORTALY_PROFILE_ID=your-profile-id
PORTALY_CALLBACK_URL=

# Dynamic pricing plan (optional, for pricingType=dynamic)
# PORTALY_DYNAMIC_PLAN_ID=your-dynamic-plan-id

# Legacy Marketplace ingress is disabled in this release (503), even with a secret.
PORTALY_MARKETPLACE_WEBHOOK_SECRET=

# ─── Cloudflare R2 (file uploads) ───
# Local self-host default: local. Existing deployments with R2 variables and
# no selector continue to infer r2 for backward compatibility.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage

# Backup is opt-in and independent from media storage.
BACKUP_PROVIDER=disabled
LOCAL_BACKUP_PATH=./backups

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
# Backup writes are intentionally opt-in. Leave false/unset locally.
DB_BACKUP_WRITES_ENABLED=false
DB_BACKUP_PREFIX=db-backups/local/
# 336 generations at the default 30-minute interval provides 7 days of history.
DB_BACKUP_KEEP=336
# R2 backups require a private bucket separate from public/media storage.
CLOUDFLARE_R2_BACKUP_BUCKET_NAME=
# Restore drills only write to an explicitly named empty *_restore_drill_* database.
DB_RESTORE_WRITES_ENABLED=false
DB_RESTORE_ALLOW_REMOTE_ISOLATED=false

# ─── Discord Integration ───
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Channel for system alerts (backup failure, etc.)
DISCORD_ALERT_CHANNEL_ID=

# ─── Cron ───
CRON_SECRET=generate-a-random-shared-secret
# Enable only on exactly one production runner.
# Exactly one canonical runner mode. Legacy SCHEDULED_TASKS_ENABLED remains
# temporarily supported when SCHEDULER_MODE is absent.
SCHEDULER_MODE=disabled
SCHEDULED_TASKS_ENABLED=false

# ─── Logging ───
# Optional: "debug" | "info" | "warn" | "error" (default: "info")
# LOG_LEVEL=info

# ─── Error monitoring (optional) ───
# Runtime capture remains disabled when no DSN is configured. Browser capture
# needs the public DSN; Sentry DSNs identify a project but are not auth tokens.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Source-map upload is optional and build-time only. Keep the auth token secret.
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_xxx

# ─── Admin ───
# Optional one-time first-admin setup. Use a random 32+ character secret,
# open /setup/admin after deployment, then remove this variable.
# ADMIN_BOOTSTRAP_TOKEN=generate-a-random-32-character-secret

# ─── Entitlement Hub Agent API ───
# Agent credentials are created and revoked in Admin > API Keys and stored in
# the agent_api_keys table. There is no AGENT_API_KEY environment selector.

# Trust only after ingress overwrites this header and direct origin access is blocked.
# Allowed: x-real-ip or cf-connecting-ip. Blank uses a shared unknown IP bucket.
TRUSTED_CLIENT_IP_HEADER=
